---
const active = Astro.props.active || '';
const navItems = [
  {label:'Reviews', href:'/posts/', key:'reviews'},

  {label:'Guides', href:'/categories/', key:'guides'},
  {label:'Security', href:'/category/security/', key:'security'},
  {label:'Workflows', href:'/search/', key:'workflows'},
];
---
<header class="nav">
  <div class="wrap">
    <a class="brand" href="/" aria-label="ToolsPilot home"><svg class="mark" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="18.4" stroke="currentColor" stroke-opacity=".18" stroke-width="1.4"/><g stroke="currentColor" stroke-opacity=".32" stroke-width="1.7" stroke-linecap="round"><line x1="20" y1="3.6" x2="20" y2="7.2"/><line x1="36.4" y1="20" x2="32.8" y2="20"/><line x1="20" y1="36.4" x2="20" y2="32.8"/><line x1="3.6" y1="20" x2="7.2" y2="20"/></g><path d="M20 8.5 L24.7 20 L20 20 Z" fill="var(--primary)"/><path d="M20 8.5 L15.3 20 L20 20 Z" fill="var(--primary)" fill-opacity=".62"/><path d="M20 31.5 L24.7 20 L20 20 Z" fill="currentColor" fill-opacity=".34"/><path d="M20 31.5 L15.3 20 L20 20 Z" fill="currentColor" fill-opacity=".2"/><circle cx="20" cy="20" r="2.5" fill="var(--paper)" stroke="var(--primary)" stroke-width="1.7"/></svg><span class="wordmark">Tools<b>Pilot</b></span></a>
    <nav class="nav-links" aria-label="Primary navigation">
      {navItems.map((item)=><a href={item.href} class:list={{ active: active === item.key }}>{item.label}</a>)}
    </nav>
    <div class="nav-spacer"></div>
    <div class="nav-actions">
      <a class="icon-btn" href="/posts/" aria-label="Search"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></a>
      <button class="icon-btn theme-toggle" data-action="theme" aria-label="Toggle theme"><svg class="sun" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.4" stroke="currentColor" stroke-width="2"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21.5"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21.5" y2="12"/></g></svg><svg class="moon" viewBox="0 0 24 24" fill="none"><path d="M20 14.5A8 8 0 1 1 10.2 4 6.4 6.4 0 0 0 20 14.5Z" fill="currentColor"/></svg></button>

      <button class="icon-btn menu-btn" data-action="open-menu" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none"><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></g></svg></button>
    </div>
  </div>
</header>
<div class="drawer" id="drawer"><div class="drawer__scrim"></div><aside class="drawer__panel"><div class="d-head"><span class="brand"><svg class="mark" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="18.4" stroke="currentColor" stroke-opacity=".18" stroke-width="1.4"/><g stroke="currentColor" stroke-opacity=".32" stroke-width="1.7" stroke-linecap="round"><line x1="20" y1="3.6" x2="20" y2="7.2"/><line x1="36.4" y1="20" x2="32.8" y2="20"/><line x1="20" y1="36.4" x2="20" y2="32.8"/><line x1="3.6" y1="20" x2="7.2" y2="20"/></g><path d="M20 8.5 L24.7 20 L20 20 Z" fill="var(--primary)"/><path d="M20 8.5 L15.3 20 L20 20 Z" fill="var(--primary)" fill-opacity=".62"/><path d="M20 31.5 L24.7 20 L20 20 Z" fill="currentColor" fill-opacity=".34"/><path d="M20 31.5 L15.3 20 L20 20 Z" fill="currentColor" fill-opacity=".2"/><circle cx="20" cy="20" r="2.5" fill="var(--paper)" stroke="var(--primary)" stroke-width="1.7"/></svg><span class="wordmark">Tools<b>Pilot</b></span></span><button class="icon-btn" data-action="close-menu" aria-label="Close"><svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></div>{navItems.map((item)=><a class="d-link" href={item.href}>{item.label}</a>)}</aside></div>
