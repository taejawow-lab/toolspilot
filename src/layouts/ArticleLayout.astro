---
import BaseLayout from './BaseLayout.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import References from '../components/References.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
export interface Props { title:string; description:string; pubDate:Date; updatedDate?:Date; heroImage?:string; tags?:string[]; category?:string; sources?:Array<{title:string;url:string;author?:string;year?:string}>; affiliate?:boolean; visualsCount?:number; hasVideo?:boolean; headings?:Array<{depth:number;slug:string;text:string}>; faq?:Array<{question:string;answer:string}>; internalLinks?:string[]; }
const { title, description, pubDate, updatedDate, heroImage, tags=[], category, sources=[], affiliate=false, visualsCount=0, headings=[], internalLinks=[] } = Astro.props;
const siteUrl = (Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://toolspilot.org'));
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description,image:heroImage,datePublished:pubDate?.toISOString(),dateModified:(updatedDate||pubDate)?.toISOString(),author:{'@type':'Organization',name:'ToolsPilot Editorial Team'},publisher:{'@type':'NewsMediaOrganization',name:'ToolsPilot',url:siteUrl}};
const categorySlug = category ? category.toLowerCase().trim().replace(/\s+/g, '-') : '';
const hasLocalHero = !!heroImage && (!heroImage.startsWith('/') || existsSync(join(process.cwd(), 'public', heroImage.slice(1))));
const displayHero = hasLocalHero ? heroImage : '';
---
<div class="progress" aria-hidden="true"><div class="progress__bar" id="progress-bar"></div></div>
<BaseLayout title={title} description={description} image={heroImage} type="article" publishedTime={pubDate?.toISOString()} modifiedTime={(updatedDate||pubDate)?.toISOString()} schema={schema} active="reviews">
  <article class="wrap tp-article-shell">
    <header class="article-head"><div class="meta">{category && <a class={category.toLowerCase().includes('security') ? 'tag tag--security' : 'tag'} href={`/category/${categorySlug}/`}>{category}</a>}<span class="tag tag--plain">{pubDate?.toLocaleDateString('en-US')}</span><span class="tag tag--plain">{sources.length} sources</span>{visualsCount > 0 && <span class="tag tag--plain">{visualsCount} visuals</span>}</div><h1>{title}</h1><p class="dek">{description}</p><p class="byline" style="justify-content:center;margin-top:18px"><span class="avatar">TP</span><span class="who">ToolsPilot Editorial Team</span><span class="read-time">· 8 min read</span></p><div class="share-rail" style="justify-content:center;margin-top:20px"><button class="icon-btn" type="button" data-action="save-article" data-title={title} aria-label="Save article" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none"><path d="M6 4h12v16l-6-4-6 4V4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></button><button class="icon-btn" type="button" data-action="share-article" data-title={title} aria-label="Share article"><svg viewBox="0 0 24 24" fill="none"><circle cx="6" cy="12" r="2.5" stroke="currentColor" stroke-width="1.7"/><circle cx="18" cy="6" r="2.5" stroke="currentColor" stroke-width="1.7"/><circle cx="18" cy="18" r="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6" stroke="currentColor" stroke-width="1.7"/></svg></button></div></header>
    {displayHero ? <img class="article-cover" src={displayHero} alt={title} width="1280" height="720" loading="eager" fetchpriority="high" decoding="async" /> : <div class="article-cover ph ph--violet"><div class="glyph"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></div></div>}
    {affiliate && <AffiliateDisclosure />}
    <div class="article-grid"><aside class="toc"><div class="toc-title">Guide map</div><ul>{headings.filter((h)=>h.depth<=3).slice(0,8).map((h)=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></aside><div class="prose" id="article-body"><slot />{sources.length > 0 && <References sources={sources} />}</div></div>
    {internalLinks.length > 0 && <section class="related-box"><span class="kicker">Related routes</span><h2 style="margin-top:8px">Keep navigating</h2><ul>{internalLinks.map((link)=><li><a href={link}>{link}</a></li>)}</ul></section>}
    {tags.length > 0 && <footer class="tag-list" aria-label="Article topics">{tags.map((tag)=><span class="tag tag--plain">#{tag}</span>)}</footer>}
  </article>
</BaseLayout>
