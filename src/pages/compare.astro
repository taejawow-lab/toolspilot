---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Comparison archive"
  description="The former comparison table has been retired while its prices, evidence links, and scoring method are rebuilt."
  noindex={true}
>
  <section class="wrap section-pad">
    <div class="card" style="max-width:780px;margin:0 auto;padding:clamp(28px,5vw,56px)">
      <span class="kicker" style="margin-bottom:16px">Archived route</span>
      <h1 style="margin-bottom:18px">This comparison is being rebuilt.</h1>
      <p class="muted" style="font-size:1.1rem;max-width:62ch;margin-bottom:24px">
        The previous table is no longer published because pricing and feature scores can become stale. Current guides link their sources and explain limitations instead of presenting unsupported rankings.
      </p>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn--primary" href="/posts/">Browse current guides</a>
        <a class="btn btn--ghost" href="/standards/">Read our standards</a>
      </div>
    </div>
  </section>
</BaseLayout>
