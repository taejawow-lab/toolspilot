---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'ToolsPilot';
const lang = import.meta.env.PUBLIC_SITE_LANG || 'en';
const hasIllust = import.meta.env.PUBLIC_HAS_CATEGORY_ILLUSTRATION === 'true';

const sections = lang === 'ko' ? [
  { label: 'I', title: '우선하는 출처', items: ['정부·규제기관·표준기관 문서', '학술 연구와 공신력 있는 조사 자료', '제조사 공식 사양과 보안 문서', '방법론을 공개한 독립 측정 자료'] },
  { label: 'II', title: '보조 출처의 사용', items: ['블로그와 커뮤니티 글은 사례 또는 추가 출처 탐색에 사용할 수 있습니다.', '업체 홍보 문구는 사실의 독립적 증거로 취급하지 않습니다.', '출처가 주장을 직접 뒷받침하지 않으면 표현을 좁히거나 삭제합니다.'] },
  { label: 'III', title: '정정 정책', body: '제보된 오류는 근거와 영향 범위를 확인합니다. 확인된 오류는 가능한 한 신속히 수정하며, 중요한 변경은 본문에 표시할 수 있습니다.' },
  { label: 'IV', title: '협찬·제휴 정책', body: '추천을 대가로 한 유료 게재는 받지 않습니다. 제휴 링크가 포함되는 경우 글 또는 공시 페이지에 관계를 명확히 밝힙니다.' },
  { label: 'V', title: 'AI 사용 정책', body: 'AI 도구가 조사 정리와 초안 작성에 도움을 줄 수 있습니다. 출처가 없는 경험을 만들지 않으며, 공개 전 중복·근거·링크·시각 자료 검사를 수행합니다.' }
] : [
  { label: 'I', title: 'Preferred Sources', items: ['Government, regulator, and standards-body documents', 'Peer-reviewed research and reputable surveys', 'Official product specifications and security documentation', 'Independent measurements with a disclosed method'] },
  { label: 'II', title: 'Using Secondary Sources', items: ['Blogs and community posts may provide examples or help locate stronger evidence.', 'Vendor marketing language is not treated as independent proof.', 'When a source does not directly support a claim, we narrow or remove the claim.'] },
  { label: 'III', title: 'Corrections Policy', body: 'Reported errors are reviewed against the evidence and their likely impact. Confirmed errors are corrected as promptly as practical, and material changes may be noted in the article.' },
  { label: 'IV', title: 'Sponsorship and Affiliate Policy', body: 'We do not accept paid placement in exchange for a recommendation. If affiliate links appear, the relationship is disclosed in the article or disclosure page.' },
  { label: 'V', title: 'AI Usage Policy', body: 'AI tools may assist with research organization and drafting. We do not invent unsupported experience, and public pages are checked for repetition, evidence, links, and visuals before release.' }
];

const heading = lang === 'ko' ? '편집 기준' : 'Editorial Standards';
---

<BaseLayout title="Editorial Standards" description={`${siteName} editorial standards`}>
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 items-end mb-16 md:mb-24">
      <div class="col-span-12 md:col-span-7">
        <p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ Standards · I–V</p>
        <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.92] tracking-[-0.025em] mb-6 text-balance" style="font-family: var(--font-display);">
          {heading}
        </h1>
      </div>
      {hasIllust && (
        <div class="col-span-12 md:col-span-5 mt-10 md:mt-0 md:-ml-8 lg:-ml-16 relative">
          <div class="absolute inset-0 bg-accent/15 rotate-2 rounded-sm" aria-hidden="true"></div>
          <img src="/images/illustrations/category.png" alt="" class="relative w-full h-auto rounded-sm -rotate-[1deg] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.25)]" loading="eager" />
        </div>
      )}
    </div>

    <div class="space-y-14">
      {sections.map((s) => (
        <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 pb-12 border-b border-border last:border-b-0">
          <div class="col-span-12 md:col-span-2">
            <p class="text-5xl md:text-6xl font-bold leading-none tracking-[-0.03em] text-accent" style="font-family: var(--font-display);">{s.label}</p>
          </div>
          <div class="col-span-12 md:col-span-10 mt-4 md:mt-1">
            <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.01em] mb-5" style="font-family: var(--font-display);">{s.title}</h2>
            {s.items && (
              <ul class="space-y-2.5 text-[17px] leading-[1.7] text-foreground/75 list-none pl-0">
                {s.items.map(it => <li class="border-l-2 border-border pl-4">{it}</li>)}
              </ul>
            )}
            {s.body && <p class="text-[17px] leading-[1.7] text-foreground/75 max-w-3xl">{s.body}</p>}
          </div>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>
