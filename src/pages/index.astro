---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
const posts = (await getCollection('posts')).filter((post)=>!post.data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const featured = posts.find((p)=>p.data.editorsPick) || posts[0];
const picks = posts.filter((p)=>p.slug !== featured?.slug).slice(0,3);
const latest = posts.slice(4,10);

const categories = [...new Set(posts.map((p)=>p.data.category).filter(Boolean))].slice(0,6);
const count = (cat)=>posts.filter((p)=>p.data.category===cat).length;
const labelFor = (cat)=>cat.split('-').join(' ').split(/\s+/).map((w)=>w ? w[0].toUpperCase()+w.slice(1).toLowerCase() : '').join(' ');
---
<BaseLayout title="Productivity Tools, App Reviews and Workflow Guides" description="Independent reviews, comparisons, and field guides for productivity tools, SaaS permissions, passkeys, and workflow automation." active="">
  <section class="hero section-pad" style="padding-top:clamp(40px,6vw,72px)">
    <div class="wrap" style="display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,5vw,64px);align-items:center">
      <div class="hero-copy reveal"><span class="kicker" style="margin-bottom:20px"><span style="width:6px;height:6px;border-radius:50%;background:var(--primary)"></span>Independent · source-led</span><h1 style="margin-bottom:20px">Navigate the tools that<br />run your <span style="color:var(--primary)">work</span>.</h1><p class="muted" style="font-size:1.18rem;max-width:46ch;margin-bottom:28px">Practical comparisons and field guides for productivity software, SaaS permissions, passkeys, and workflow automation — with linked sources, limitations, and reversible next steps.</p><a class="searchbar" style="max-width:440px;margin-bottom:22px" href="/posts/"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span style="flex:1;color:var(--ink-2)">Browse {posts.length} in-depth guides…</span><kbd>/</kbd></a><div style="display:flex;gap:36px;flex-wrap:wrap"><div class="stat"><b>{posts.length}</b><span>Published guides</span></div><div class="stat"><b>0</b><span>Paid placements</span></div><div class="stat"><b>8+</b><span>Sources per guide</span></div></div></div>
      {featured && <ArticleCard title={featured.data.title} description={featured.data.description} href={`/posts/${featured.slug}`} image={featured.data.heroImage} category={featured.data.category} pubDate={featured.data.pubDate} variant="feature" editorsPick={featured.data.editorsPick || true} readingTime={featured.data.readingTime || 14} />}
    </div>
  </section>
  <section class="wrap" style="padding-bottom:8px"><div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center"><span class="kicker kicker--muted" style="margin-right:6px">Browse</span>{categories.map((cat)=><a class="chip" href={`/category/${cat.toLowerCase().trim().replace(/\s+/g,'-')}/`}>{labelFor(cat)} <span class="count">{count(cat)}</span></a>)}</div></section>
  <section class="section-pad" style="padding-bottom:clamp(28px,4vw,48px)"><div class="wrap"><div class="eyrow"><div class="lead"><span class="kicker">Curated this week</span><h2>Editor's picks</h2></div><a class="btn btn--ghost btn--sm" href="/posts/">View all reviews →</a></div><div class="grid-cards">{picks.map((post,i)=><ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} index={i+1} editorsPick={post.data.editorsPick} rating={post.data.rating} readingTime={post.data.readingTime || 9} />)}</div></div></section>

  <section class="section-pad" style="padding-top:clamp(28px,4vw,48px)"><div class="wrap"><div class="eyrow"><div class="lead"><span class="kicker">Recently published</span><h2>Latest guides & reviews</h2></div><a class="btn btn--ghost btn--sm" href="/posts/">Browse archive →</a></div><div class="grid-cards">{latest.map((post,i)=><ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} index={i+4} editorsPick={post.data.editorsPick} rating={post.data.rating} readingTime={post.data.readingTime || 8} />)}</div></div></section>
</BaseLayout>
