---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'ToolsPilot';
const lang = import.meta.env.PUBLIC_SITE_LANG || 'en';
const hasIllust = import.meta.env.PUBLIC_HAS_FEATURE_ILLUSTRATION === 'true';

const stepsKo = [
  { n: '01', title: '독자 문제 정의', body: '검색량만을 기준으로 주제를 만들지 않습니다. 독자가 실제로 내려야 할 결정, 필요한 조건, 안전·개인정보·비용상의 제한을 먼저 정의합니다.' },
  { n: '02', title: '근거 수집', body: '공식 문서, 표준, 연구 자료, 제조사 사양과 신뢰할 수 있는 측정 자료를 우선합니다. 출처의 날짜와 적용 범위를 확인하고 서로 다른 성격의 자료를 구분합니다.' },
  { n: '03', title: '초안과 한계 작성', body: 'AI 도구가 구조화와 초안 작성에 도움을 줄 수 있습니다. 직접 수행하지 않은 구매·사용·시험 경험을 만들지 않으며, 근거가 부족한 부분은 한계 또는 확인 항목으로 표시합니다.' },
  { n: '04', title: '편집 검토', body: '중요한 주장과 연결된 출처, 과도하게 단정적인 표현, 반복 문단, 내부 링크와 시각 자료를 발행 전에 검토합니다. 근거로 방어할 수 없는 문장은 수정하거나 제거합니다.' },
  { n: '05', title: '기술 검사', body: '공개 글 목록, 단어·출처·시각 자료 수, 중복 문단, 깨진 링크와 로컬 자산을 자동 검사합니다. 검사가 실패하면 배포가 중단됩니다.' },
  { n: '06', title: '정정과 갱신', body: '독자는 편집부 이메일로 오류를 제보할 수 있습니다. 확인된 오류와 오래된 정보는 중요도와 영향 범위를 검토한 뒤 수정하며, 필요한 경우 변경 내용을 글에 표시합니다.' }
];
const stepsEn = [
  { n: '01', title: 'Define the Reader Problem', body: 'We do not select topics from search volume alone. Each guide starts with the decision a reader needs to make and the relevant constraints around safety, privacy, cost, and reversibility.' },
  { n: '02', title: 'Collect Evidence', body: 'We prefer official documentation, standards, research, manufacturer specifications, and credible measurement sources. Dates, scope, and the difference between primary evidence and commentary are considered.' },
  { n: '03', title: 'Draft with Limitations', body: 'AI tools may assist with structure and drafting. We do not invent purchases, usage, or testing experience, and we label uncertainty or verification steps where the available evidence is incomplete.' },
  { n: '04', title: 'Editorial Review', body: 'Before publication, we review important claims against their sources and check for overconfident language, repeated passages, internal-link problems, and unsuitable visuals. Claims we cannot support are revised or removed.' },
  { n: '05', title: 'Technical Checks', body: 'Automated checks cover the public article allowlist, measured words, sources and visuals, repeated paragraphs, broken links, and missing local assets. A failed check blocks deployment.' },
  { n: '06', title: 'Corrections and Updates', body: 'Readers may report errors by email. Confirmed errors and outdated information are reviewed according to their impact and corrected when warranted; material changes may be noted in the article.' }
];
const steps = lang === 'ko' ? stepsKo : stepsEn;
const heading = lang === 'ko' ? '편집 프로세스' : 'Editorial Process';
const lede = lang === 'ko' ? `${siteName}가 공개 글을 선정하고 검토하는 현재 기준입니다.` : `The current process ${siteName} uses to select and review public articles.`;
---

<BaseLayout title="Editorial Process" description={`How ${siteName} produces content`}>
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <!-- editorial header -->
    <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 items-end mb-16 md:mb-24">
      <div class="col-span-12 md:col-span-7">
        <p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ Method · 6 Steps</p>
        <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.92] tracking-[-0.025em] mb-6 text-balance" style="font-family: var(--font-display);">
          {heading}
        </h1>
        <p class="text-lg md:text-xl text-foreground/70 max-w-xl leading-relaxed">
          {lede}
        </p>
      </div>
      {hasIllust && (
        <div class="col-span-12 md:col-span-5 mt-10 md:mt-0 md:-ml-8 lg:-ml-16 relative">
          <div class="absolute inset-0 bg-primary/15 -rotate-2 rounded-sm" aria-hidden="true"></div>
          <img src="/images/illustrations/feature.png" alt="" class="relative w-full h-auto rounded-sm rotate-[1.5deg] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.25)]" loading="eager" />
        </div>
      )}
    </div>

    <!-- numbered steps grid -->
    <div class="space-y-12 md:space-y-16">
      {steps.map((s) => (
        <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 pb-12 md:pb-16 border-b border-border last:border-b-0">
          <div class="col-span-12 md:col-span-3">
            <p class="text-7xl md:text-8xl font-bold leading-none tracking-[-0.04em] text-accent" style="font-family: var(--font-display);">
              {s.n}
            </p>
          </div>
          <div class="col-span-12 md:col-span-9 mt-4 md:mt-2">
            <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.01em] mb-4" style="font-family: var(--font-display);">
              {s.title}
            </h2>
            <p class="text-[17px] leading-[1.7] text-foreground/75 max-w-3xl">{s.body}</p>
          </div>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>
