---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const posts = (await getCollection('posts')).filter((post)=>!post.data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const categories = ['all', ...new Set(posts.map((p)=>p.data.category).filter(Boolean).map((c)=>c.toLowerCase().trim().replace(/\s+/g,'-')))];
const labelFor = (slug)=> slug === 'all' ? 'All' : slug.split('-').map((w)=>w[0].toUpperCase()+w.slice(1)).join(' ');
const countFor = (slug)=> slug === 'all' ? posts.length : posts.filter((p)=>(p.data.category||'').toLowerCase().trim().replace(/\s+/g,'-')===slug).length;
---
<BaseLayout title="Reviews Archive" description="Search and filter all ToolsPilot reviews, guides, and workflows." active="reviews">
  <section class="archive-head"><div class="wrap"><div class="top"><div><span class="kicker">Reviews archive</span><h1 style="margin-top:12px">Find the tool review that matches your stack.</h1><p class="muted" style="font-size:1.1rem;max-width:58ch;margin-top:14px">Search productivity tools, SaaS permissions, passkeys, and workflow automation guides. Filters and search run locally in your browser.</p></div><label class="searchbar"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><input id="archive-search" data-search-focus type="search" placeholder="Search reviews, tags, tools…" /><kbd>/</kbd></label></div></div></section>
  <div class="filter-strip" id="filter-root"><div class="wrap"><div class="chip-row">{categories.map((cat,i)=><button class:list={['chip', {'is-active': i===0}]} data-cat={cat} aria-pressed={i===0 ? 'true' : 'false'}>{labelFor(cat)} <span class="count">{countFor(cat)}</span></button>)}</div></div></div>
  <section class="section-pad" style="padding-top:32px"><div class="wrap"><p class="kicker kicker--muted" style="margin-bottom:18px"><span id="result-count">{posts.length}</span> visible routes</p><div class="archive-grid" id="archive-grid">{posts.map((post,i)=><ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} index={i} readingTime={post.data.readingTime || 8} />)}</div><div class="empty-state" id="empty-state" style="display:none;margin-top:28px"><h3>No matching routes</h3><p>Try a broader tool, category, or workflow keyword.</p></div></div></section>
</BaseLayout>
